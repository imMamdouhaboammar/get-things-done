{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/imMamdouhaboammar/get-things-done/blob/main/adapters/companions.schema.json",
  "title": "Get Things Done companion interoperability registry",
  "type": "object",
  "required": ["$schema", "schema_version", "purpose", "companions"],
  "properties": {
    "$schema": {"const": "./companions.schema.json"},
    "schema_version": {"type": "string"},
    "purpose": {"type": "string", "minLength": 1},
    "companions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "id",
          "label",
          "kind",
          "relationship",
          "companion_role",
          "ownership",
          "integration",
          "inputs",
          "outputs",
          "evidence_contract",
          "failure_policy",
          "authority_boundary",
          "guardrails"
        ],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "label": {"type": "string", "minLength": 1},
          "kind": {"enum": ["orchestration", "evaluation", "methodology", "security", "documentation"]},
          "relationship": {"enum": ["complementary", "optional"]},
          "companion_role": {"type": "string", "minLength": 1},
          "transport": {"type": "string", "minLength": 1},
          "ownership": {
            "type": "object",
            "required": ["gtd", "companion"],
            "properties": {
              "gtd": {"type": "string", "minLength": 1},
              "companion": {"type": "string", "minLength": 1}
            },
            "additionalProperties": false
          },
          "integration": {"type": "string", "minLength": 1},
          "inputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "outputs": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          },
          "evidence_contract": {"type": "string", "minLength": 1},
          "failure_policy": {"type": "string", "minLength": 1},
          "authority_boundary": {"type": "string", "minLength": 1},
          "guardrails": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
