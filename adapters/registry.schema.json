{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/imMamdouhaboammar/get-things-done/blob/main/adapters/registry.schema.json",
  "title": "Get Things Done adapter registry",
  "type": "object",
  "required": ["schema_version", "canonical_standard", "plugin_standard", "portability_contract", "adapters"],
  "properties": {
    "schema_version": {"type": "string"},
    "canonical_standard": {"const": "Agent Skills"},
    "plugin_standard": {"type": "string"},
    "portability_contract": {"type": "string", "minLength": 1},
    "adapters": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "label", "family", "support", "kind", "export", "capabilities"],
        "properties": {
          "id": {"type": "string", "minLength": 1, "pattern": "^[a-z0-9][a-z0-9-]*$"},
          "label": {"type": "string", "minLength": 1},
          "family": {"type": "string", "minLength": 1},
          "support": {
            "enum": ["native-standard", "first-class", "portable", "authoring-bridge", "conditional"]
          },
          "kind": {"type": "string", "minLength": 1},
          "project_path": {"type": "string", "minLength": 1},
          "fallback_path": {"type": "string", "minLength": 1},
          "manifest": {"type": "string", "minLength": 1},
          "export": {"type": "string", "minLength": 1},
          "requires": {"type": "string", "minLength": 1},
          "capabilities": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {"type": "string", "minLength": 1}
          }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
