{
  "$schema": "./registry.schema.json",
  "schema_version": "1.3",
  "canonical_standard": "Agent Skills",
  "plugin_standard": "Agent Plugins 1.0.0",
  "portability_contract": "Any agent that consumes the Agent Skills standard can use the canonical skills-layout export without requiring a dedicated GTD behavior fork.",
  "adapters": [
    {"id":"agent-skills","label":"Agent Skills / Universal","family":"standard","support":"native-standard","kind":"skills","project_path":".agents/skills","export":"skills-layout","capabilities":["skills","portable-to-conforming-agents"]},
    {"id":"agent-plugins","label":"Agent Plugins","family":"standard","support":"native-standard","kind":"plugin","manifest":"plugin.json","export":"agent-plugin","capabilities":["skills","plugin-package"]},
    {"id":"claude-ai","label":"Claude AI Skills","family":"anthropic","support":"portable","kind":"skills","project_path":".claude/skills","export":"skills-layout","capabilities":["skills"]},
    {"id":"claude-code","label":"Claude Code","family":"anthropic","support":"first-class","kind":"skills+plugin","project_path":".claude/skills","manifest":".claude-plugin/plugin.json","export":"claude-plugin","capabilities":["skills","plugin-package"]},
    {"id":"claude-marketplace","label":"Claude Marketplace","family":"anthropic","support":"first-class","kind":"marketplace","manifest":".claude-plugin/marketplace.json","export":"claude-plugin","capabilities":["skills","plugin-package","marketplace"]},
    {"id":"claude-cowork","label":"Claude Cowork","family":"anthropic","support":"first-class","kind":"skills+plugin","project_path":".claude/skills","manifest":".claude-plugin/plugin.json","export":"claude-plugin","capabilities":["skills","plugin-package"]},
    {"id":"chatgpt-web","label":"ChatGPT Web","family":"openai","support":"first-class","kind":"plugin","manifest":".codex-plugin/plugin.json","export":"openai-plugin","capabilities":["skills","plugin-package"]},
    {"id":"chatgpt-work","label":"ChatGPT Work","family":"openai","support":"first-class","kind":"plugin","manifest":".codex-plugin/plugin.json","export":"openai-plugin","capabilities":["skills","plugin-package"]},
    {"id":"chatgpt-plugin","label":"ChatGPT Plugin","family":"openai","support":"first-class","kind":"plugin","manifest":".codex-plugin/plugin.json","export":"openai-plugin","capabilities":["skills","plugin-package"]},
    {"id":"codex","label":"Codex","family":"openai","support":"first-class","kind":"skills+plugin","project_path":".agents/skills","manifest":".codex-plugin/plugin.json","export":"openai-plugin","capabilities":["skills","plugin-package"]},
    {"id":"cursor","label":"Cursor","family":"cursor","support":"first-class","kind":"skills","project_path":".cursor/skills","fallback_path":".agents/skills","export":"skills-layout","capabilities":["skills"]},
    {"id":"kimi","label":"Kimi Code","family":"moonshot","support":"first-class","kind":"skills+plugin","project_path":".kimi-code/skills","fallback_path":".agents/skills","manifest":"kimi.plugin.json","export":"kimi-plugin","capabilities":["skills","plugin-package"]},
    {"id":"grok","label":"Grok Build","family":"xai","support":"first-class","kind":"skills","project_path":".grok/skills","fallback_path":".agents/skills","export":"skills-layout","capabilities":["skills"]},
    {"id":"deepseek","label":"DeepSeek DeepCode","family":"deepseek","support":"first-class","kind":"skills","project_path":".deepcode/skills","fallback_path":".agents/skills","export":"skills-layout","capabilities":["skills"]},
    {"id":"antigravity","label":"Antigravity / Gemini CLI","family":"google","support":"first-class","kind":"skills","project_path":".gemini/config/skills","fallback_path":".agents/skills","export":"skills-layout","capabilities":["skills"]},
    {"id":"homebrew","label":"Homebrew","family":"distribution","support":"first-class","kind":"package-manager","manifest":"Formula/get-things-done.rb","export":"homebrew-formula","capabilities":["cli-install","skills-bundle","head-install"]},
    {"id":"shell","label":"Shell Installer","family":"distribution","support":"first-class","kind":"installer","manifest":"install.sh","export":"shell-bundle","capabilities":["skills","custom-install-root","multi-host-install"]},
    {"id":"skills-sh","label":"Vercel skills.sh","family":"distribution","support":"first-class","kind":"registry","manifest":"skills.sh.json","export":"skills-sh","capabilities":["skills-distribution","updates"]},
    {"id":"skill-kit","label":"Contentful Skill Kit","family":"authoring","support":"authoring-bridge","kind":"authoring","export":"skill-kit-bridge","capabilities":["authoring","agent-skills-output"]},
    {"id":"glama","label":"Glama","family":"mcp","support":"conditional","kind":"mcp-registry","export":"conditional-mcp","requires":"mcp.json","capabilities":["mcp-registry"]}
  ]
}
