{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ImproveFinding",
  "type": "object",
  "required": ["id", "title", "category", "evidence", "impact", "effort", "risk", "confidence", "fix_sketch"],
  "properties": {
    "id": { "type": "string" },
    "title": { "type": "string" },
    "category": {
      "type": "string",
      "enum": ["correctness", "security", "perf", "tests", "tech-debt", "migration", "dx", "docs", "direction"]
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" },
      "minItems": 1
    },
    "impact": { "type": "string" },
    "effort": {
      "type": "string",
      "enum": ["S", "M", "L"]
    },
    "risk": {
      "type": "string",
      "enum": ["LOW", "MED", "HIGH"]
    },
    "confidence": {
      "type": "string",
      "enum": ["HIGH", "MED", "LOW"]
    },
    "fix_sketch": { "type": "string" }
  }
}
